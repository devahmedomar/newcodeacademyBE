# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/new-code-academy

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Optional: env flag so the local dev server runs on demand (not required on Vercel)
PORT=4000

# Initial teacher account (created on first startup if no users exist)
SEED_TEACHER_NAME=Mr. Ahmed
SEED_TEACHER_EMAIL=admin@newcodeacademy.com
SEED_TEACHER_PASSWORD=ChangeMe123!

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201