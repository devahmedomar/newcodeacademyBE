# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/new-code-academy

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Optional: env flag so the local dev server runs on demand (not required on Vercel)
PORT=4000

# Initial teacher account (created on first startup if no users exist)
SEED_TEACHER_NAME=Mr. Ahmed
SEED_TEACHER_EMAIL=admin@newcodeacademy.com
SEED_TEACHER_PASSWORD=ChangeMe123!

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# --- AI exams (Google Gemini) ------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Without this, every AI exam route returns 503 and the rest of the app is unaffected.
GEMINI_API_KEY=your-gemini-api-key-here

# Model used for question generation and short-answer grading.
# gemini-3.5-flash is on the free tier and supports structured output.
GEMINI_MODEL=gemini-3.5-flash

# Upload / extraction limits for book PDFs. Vercel caps a single request body at
# 4.5 MB on every plan, so files are uploaded in 3 MB chunks regardless of these.
PDF_MAX_MB=80
PDF_MAX_PAGES=800